<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rgbd_odometry</name>
  <version>0.1.0</version>
  <description>Post-process a recorded umi_recorder episode bag: compute per-camera RGBD visual odometry with Open3D and write it back into the bag as a visual_odom PoseStamped topic</description>
  <maintainer email="aho3@ncsu.edu">aho3</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>rosbag2_py</depend>
  <!-- open3d + a modern numpy run inside this package's own venv (.venv/),
       not in this process - see rgbd_odometry/compute_odometry.py's module
       docstring for why. Set it up with:
         virtualenv <this_package>/.venv
         <this_package>/.venv/bin/pip install open3d numpy -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
