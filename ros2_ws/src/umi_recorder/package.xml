<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>umi_recorder</name>
  <version>0.1.0</version>
  <description>Web UI to record synchronized UMI gripper demonstrations (mocap trajectory + RealSense RGB-D) into a ROS 2 bag</description>
  <maintainer email="aho3@ncsu.edu">aho3</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>ament_index_python</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>rosbag2_py</depend>
  <depend>python3-flask</depend>
  <!-- pyrealsense2 is not resolvable via rosdep/apt on this platform;
       install manually: pip3 install pyrealsense2 (see README/CLAUDE.md) -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
